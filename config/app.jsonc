{
    "start-scene": "menu",
    "window": {
        "title": "Game",
        "size": {
            "width": 1280,
            "height": 720
        },
        "fullscreen": false
    },
    "scene": {
        "terrain": {
            "height": 100,
            "waterLevel": 5,
            "stoneLevel": 4
        },
        "renderer": {
            "sky": "assets/textures/sky.png",
            "postprocess": "assets/shaders/postprocess/godrays.frag"
        },
        "assets": {
            "shaders": {
                "tinted": {
                    "vs": "assets/shaders/tinted.vert",
                    "fs": "assets/shaders/tinted.frag"
                },
                "textured": {
                    "vs": "assets/shaders/textured.vert",
                    "fs": "assets/shaders/textured.frag"
                },
                "lit": {
                    "vs": "assets/shaders/lit.vert",
                    "fs": "assets/shaders/lit.frag"
                }
            },
            "textures": {
                "moon": "assets/textures/moon.jpg",
                "grass": "assets/textures/default_grass.png",
                "grass-top": "assets/textures/grass_block_top.png",
                "grass-side": "assets/textures/grass_block_side.png",
                "dirt": "assets/textures/dirt.png",
                "wood": "assets/textures/Wood.png",
                "stone": "assets/textures/stone.png",
                "sand": "assets/textures/sand.png",
                "clay": "assets/textures/clay.png",
                "glass": "assets/textures/glass.png",
                "monkey": "assets/textures/monkey.png",
                "hearts": "assets/textures/hearts.png",
                "enemy-zombie-tex":   "assets/textures/zombie.png",
                "enemy-skeleton-tex": "assets/textures/skeleton.png",
                "enemy-creeper-tex":  "assets/textures/creeper.png"
            },
            "meshes": {
                "cube": "assets/models/cube.obj",
                "monkey": "assets/models/monkey.obj",
                "plane": "assets/models/plane.obj",
                "sphere": "assets/models/sphere.obj"
            },
            "samplers": {
                "default": {},
                "pixelated": {
                    "MAG_FILTER": "GL_NEAREST",
                    "MIN_FILTER": "GL_NEAREST",
                    "WRAP_S": "GL_REPEAT",
                    "WRAP_T": "GL_REPEAT"
                }
            },
            "materials": {
                "metal": {
                    "type": "tinted",
                    "shader": "tinted",
                    "pipelineState": {
                        "faceCulling": { "enabled": false },
                        "depthTesting": { "enabled": true }
                    },
                    "tint": [0.45, 0.4, 0.5, 1]
                },
                "lit-red": {
                    "type": "lit",
                    "shader": "lit",
                    "pipelineState": {
                        "faceCulling": { "enabled": false },
                        "depthTesting": { "enabled": true }
                    },
                    "tint": [1, 0.3, 0.3, 1],
                    "shininess": 32.0
                },
                "lit-blue": {
                    "type": "lit",
                    "shader": "lit",
                    "pipelineState": {
                        "faceCulling": { "enabled": false },
                        "depthTesting": { "enabled": true }
                    },
                    "tint": [0.3, 0.3, 1.0, 1],
                    "shininess": 64.0
                },
                "lit-gold": {
                    "type": "lit",
                    "shader": "lit",
                    "pipelineState": {
                        "faceCulling": { "enabled": false },
                        "depthTesting": { "enabled": true }
                    },
                    "tint": [1.0, 0.84, 0.0, 1],
                    "shininess": 128.0
                },
                "glass": {
                    "type": "textured",
                    "shader": "textured",
                    "pipelineState": {
                        "faceCulling": { "enabled": false },
                        "depthTesting": { "enabled": true },
                        "blending": {
                            "enabled": true,
                            "sourceFactor": "GL_SRC_ALPHA",
                            "destinationFactor": "GL_ONE_MINUS_SRC_ALPHA"
                        },
                        "depthMask": false
                    },
                    "transparent": true,
                    "tint": [1, 1, 1, 1],
                    "texture": "glass",
                    "sampler": "pixelated"
                },
                "grass": {
                    "type": "textured",
                    "shader": "textured",
                    "pipelineState": {
                        "faceCulling": { "enabled": false },
                        "depthTesting": { "enabled": true }
                    },
                    "tint": [1, 1, 1, 1],
                    "texture": "grass",
                    "sampler": "pixelated"
                },
                "grass-top": {
                    "type": "textured",
                    "shader": "textured",
                    "pipelineState": {
                        "faceCulling": { "enabled": false },
                        "depthTesting": { "enabled": true }
                    },
                    "tint": [1, 1, 1, 1],
                    "texture": "grass-top",
                    "sampler": "pixelated"
                },
                "grass-side": {
                    "type": "textured",
                    "shader": "textured",
                    "pipelineState": {
                        "faceCulling": { "enabled": false },
                        "depthTesting": { "enabled": true }
                    },
                    "tint": [1, 1, 1, 1],
                    "texture": "grass-side",
                    "sampler": "pixelated"
                },
                "dirt": {
                    "type": "textured",
                    "shader": "textured",
                    "pipelineState": {
                        "faceCulling": { "enabled": false },
                        "depthTesting": { "enabled": true }
                    },
                    "tint": [1, 1, 1, 1],
                    "texture": "dirt",
                    "sampler": "pixelated"
                },
                "wood": {
                    "type": "textured",
                    "shader": "textured",
                    "pipelineState": {
                        "faceCulling": { "enabled": true },
                        "depthTesting": { "enabled": true }
                    },
                    "tint": [1, 1, 1, 1],
                    "texture": "wood",
                    "sampler": "pixelated"
                },
                "monkey": {
                    "type": "textured",
                    "shader": "textured",
                    "pipelineState": {
                        "faceCulling": { "enabled": false },
                        "depthTesting": { "enabled": true }
                    },
                    "tint": [1, 1, 1, 1],
                    "texture": "monkey",
                    "sampler": "default"
                },
                "moon": {
                    "type": "textured",
                    "shader": "textured",
                    "pipelineState": {
                        "faceCulling": { "enabled": false },
                        "depthTesting": { "enabled": true }
                    },
                    "tint": [1, 1, 1, 1],
                    "texture": "moon",
                    "sampler": "default"
                },
                "default": {
                    "type": "tinted",
                    "shader": "tinted",
                    "pipelineState": {
                        "faceCulling": { "enabled": true },
                        "depthTesting": { "enabled": true }
                    },
                    "tint": [1.0, 0.0, 1.0, 1.0]
                },
                "stone": {
                    "type": "textured",
                    "shader": "textured",
                    "pipelineState": {
                        "faceCulling": { "enabled": true },
                        "depthTesting": { "enabled": true }
                    },
                    "tint": [1.0, 1.0, 1.0, 1.0],
                    "texture": "stone",
                    "sampler": "pixelated"
                },
                "water": {
                    "type": "tinted",
                    "shader": "tinted",
                    "pipelineState": {
                        "faceCulling": { "enabled": false },
                        "depthTesting": { "enabled": true },
                        "blending": {
                            "enabled": true,
                            "sourceFactor": "GL_SRC_ALPHA",
                            "destinationFactor": "GL_ONE_MINUS_SRC_ALPHA"
                        }
                    },
                    "transparent": true,
                    "tint": [0.2, 0.4, 0.9, 0.8]
                },
                "sand": {
                    "type": "textured",
                    "shader": "textured",
                    "pipelineState": {
                        "faceCulling": { "enabled": true },
                        "depthTesting": { "enabled": true }
                    },
                    "tint": [1.0, 1.0, 1.0, 1.0],
                    "texture": "sand",
                    "sampler": "pixelated"
                },
                "clay": {
                    "type": "textured",
                    "shader": "textured",
                    "pipelineState": {
                        "faceCulling": { "enabled": true },
                        "depthTesting": { "enabled": true }
                    },
                    "tint": [1.0, 1.0, 1.0, 1.0],
                    "texture": "clay",
                    "sampler": "pixelated"
                },
                "sun-material": {
                    "type": "tinted",
                    "shader": "tinted",
                    "pipelineState": {
                        "faceCulling": { "enabled": false },
                        "depthTesting": { "enabled": true }
                    },
                    "tint": [1.0, 1.0, 0.8, 1.0]
                },
                "steve-skin": {
                    "type": "tinted",
                    "shader": "tinted",
                    "pipelineState": {
                        "faceCulling": { "enabled": false },
                        "depthTesting": { "enabled": false },
                        "depthMask": false
                    },
                    "tint": [0.96, 0.80, 0.66, 1.0]
                },
                "steve-shirt": {
                    "type": "tinted",
                    "shader": "tinted",
                    "pipelineState": {
                        "faceCulling": { "enabled": false },
                        "depthTesting": { "enabled": false },
                        "depthMask": false
                    },
                    "tint": [0.17, 0.52, 0.92, 1.0]
                },
                "wireframe": {
                    "type": "tinted",
                    "shader": "tinted",
                    "pipelineState": {
                        "faceCulling": { "enabled": false },
                        "depthTesting": { "enabled": true, "function": "GL_LEQUAL" },
                        "polygonMode": "GL_LINE",
                        "lineWidth": 1.0,
                        "depthMask": false
                    },
                    "tint": [0.0, 0.0, 0.0, 1.0]
                },
                "highlight-fill": {
                    "type": "tinted",
                    "shader": "tinted",
                    "pipelineState": {
                        "faceCulling": { "enabled": false },
                        "depthTesting": { "enabled": true, "function": "GL_LEQUAL" },
                        "blending": {
                            "enabled": true,
                            "sourceFactor": "GL_SRC_ALPHA",
                            "destinationFactor": "GL_ONE_MINUS_SRC_ALPHA"
                        },
                        "depthMask": false
                    },
                    "transparent": true,
                    "tint": [0.0, 0.0, 0.0, 0.2]
                },
                "enemy-zombie": {
                    "type": "textured",
                    "shader": "textured",
                    "pipelineState": {
                        "faceCulling": { "enabled": false },
                        "depthTesting": { "enabled": true }
                    },
                    "tint": [1, 1, 1, 1],
                    "texture": "enemy-zombie-tex",
                    "sampler": "pixelated"
                },
                "enemy-skeleton": {
                    "type": "textured",
                    "shader": "textured",
                    "pipelineState": {
                        "faceCulling": { "enabled": false },
                        "depthTesting": { "enabled": true }
                    },
                    "tint": [1, 1, 1, 1],
                    "texture": "enemy-skeleton-tex",
                    "sampler": "pixelated"
                },
                "enemy-creeper": {
                    "type": "textured",
                    "shader": "textured",
                    "pipelineState": {
                        "faceCulling": { "enabled": false },
                        "depthTesting": { "enabled": true }
                    },
                    "tint": [1, 1, 1, 1],
                    "texture": "enemy-creeper-tex",
                    "sampler": "pixelated"
                }
            }
        },
        "world": [
            {
                "position": [0, 0, 0],
                "rotation": [0, 0, 0],
                "name": "daylight",
                "components": [{
                    "type": "Light",
                    "lightType": "directional",
                    "color": [0.95, 0.98, 1.0],
                    "ambient": [1.0, 0.9, 0.8],
                    "enabled": true
                }]
            },
            {
                "position": [0, 0, 0],
                "rotation": [0, 0, 0],
                "name": "nightlight",
                "components": [{
                    "type": "Light",
                    "lightType": "directional",
                    "color": [0.05, 0.05, 0.2],
                    "ambient": [0.01, 0.01, 0.03],
                    "enabled": false
                }]
            },
            {
                "position": [0, 50, -50],
                "scale": [2.0, 2.0, 2.0],
                "name": "sun",
                "components": [
                    {
                        "type": "Mesh Renderer",
                        "mesh": "cube",
                        "material": "sun-material"
                    },
                    {
                        "type": "Light",
                        "lightType": "point",
                        "color": [1.0, 0.95, 0.8],
                        "ambient": [0.6, 0.6, 0.5],
                        "attenuation": [1.0, 0.02, 0.001],
                        "enabled": true
                    }
                ]
            },
            {
                "position": [8, 20, 25],
                "rotation": [-45, 0, 0],
                "components": [
                    { "type": "Camera" },
                    { "type": "PlayerComponent" },
                    {
                        "type": "AABBCollider",
                        "halfSize": [0.3, 0.9, 0.3],
                        "center": [0, -0.9, 0]
                    }
                ]
            }
        ]
    }
}