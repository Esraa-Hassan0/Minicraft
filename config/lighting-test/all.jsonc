{
    "start-scene": "renderer-test",
    "window": {
        "title": "Lighting Test Suite",
        "size": {"width": 512, "height": 512},
        "fullscreen": false
    },
    "screenshots": {
        "directory": "screenshots/lighting",
        "requests": [
            {"file": "01-directional.png", "frame": 1},
            {"file": "02-point.png", "frame": 2},
            {"file": "03-spot.png", "frame": 3},
            {"file": "04-multi.png", "frame": 4}
        ]
    },
    "scene": {
        "renderer": {"sky": "assets/textures/sky.jpg"},
        "assets": {
            "shaders": {
                "lit": {"vs": "assets/shaders/lit.vert", "fs": "assets/shaders/lit.frag"}
            },
            "meshes": {"sphere": "assets/models/sphere.obj"},
            "samplers": {"default": {}},
            "materials": {
                "lit-mat": {
                    "type": "lit",
                    "shader": "lit",
                    "pipelineState": {"faceCulling": {"enabled": false}, "depthTesting": {"enabled": true}},
                    "tint": [0.9, 0.9, 0.9, 1],
                    "shininess": 64.0
                }
            }
        },
        "world": [
            {
                "position": [0, 0, 10],
                "components": [{"type": "Camera"}]
            },
            {
                "position": [0, 0, 0],
                "components": [
                    {"type": "Mesh Renderer", "mesh": "sphere", "material": "lit-mat"}
                ]
            },
            {
                "position": [3, 2, -2],
                "components": [
                    {"type": "Light", "lightType": "point", "color": [1.0, 0.2, 0.2], "ambient": [0.02, 0.0, 0.0], "attenLinear": 0.18, "attenQuadratic": 0.08}
                ]
            },
            {
                "position": [-3, 2, -2],
                "components": [
                    {"type": "Light", "lightType": "point", "color": [0.2, 1.0, 0.2], "ambient": [0.0, 0.02, 0.0], "attenLinear": 0.18, "attenQuadratic": 0.08}
                ]
            },
            {
                "position": [0, 4, -2],
                "components": [
                    {"type": "Light", "lightType": "point", "color": [0.2, 0.2, 1.0], "ambient": [0.0, 0.0, 0.02], "attenLinear": 0.18, "attenQuadratic": 0.08}
                ]
            },
            {
                "position": [0, 10, 5],
                "rotation": [30, 0, 0],
                "components": [
                    {"type": "Light", "lightType": "directional", "color": [1.0, 0.95, 0.8], "ambient": [0.15, 0.15, 0.15]}
                ]
            }
        ]
    }
}