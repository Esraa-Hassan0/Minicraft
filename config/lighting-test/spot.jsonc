{
    "start-scene": "renderer-test",
    "window": {
        "title": "Spot Light Test",
        "size": {"width": 512, "height": 512},
        "fullscreen": false
    },
    "screenshots": {
        "directory": "screenshots/lighting",
        "requests": [{"file": "spot.png", "frame": 1}]
    },
    "scene": {
        "renderer": {"sky": "assets/textures/sky.jpg"},
        "assets": {
            "shaders": {
                "lit": {"vs": "assets/shaders/lit.vert", "fs": "assets/shaders/lit.frag"}
            },
            "meshes": {"sphere": "assets/models/sphere.obj"},
            "samplers": {"default": {}},
            "materials": {
                "lit-mat": {
                    "type": "lit",
                    "shader": "lit",
                    "pipelineState": {"faceCulling": {"enabled": false}, "depthTesting": {"enabled": true}},
                    "tint": [0.8, 0.5, 0.5, 1],
                    "shininess": 32.0
                }
            }
        },
        "world": [
            {
                "position": [0, 0, 8],
                "components": [{"type": "Camera"}]
            },
            {
                "position": [0, 0, 0],
                "components": [
                    {"type": "Mesh Renderer", "mesh": "sphere", "material": "lit-mat"}
                ]
            },
            {
                "position": [0, 5, 0],
                "rotation": [0, 0, 0],
                "components": [
                    {"type": "Light", "lightType": "spot", "color": [1.0, 0.9, 0.7], "ambient": [0.05, 0.05, 0.05], "innerCutoff": 12.5, "outerCutoff": 25.0}
                ]
            }
        ]
    }
}