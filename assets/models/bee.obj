mtllib minecraft_bee.mtl
o Bee
# === BODY: 7x7x7 box centered at origin ===
v -3.5 -3.5  3.5
v  3.5 -3.5  3.5
v  3.5  3.5  3.5
v -3.5  3.5  3.5
v -3.5 -3.5 -3.5
v  3.5 -3.5 -3.5
v  3.5  3.5 -3.5
v -3.5  3.5 -3.5

# === RIGHT WING: extends from top toward +X ===
v  0.5  3.6  2.5
v  9.0  5.0  2.5
v  9.0  5.0 -2.5
v  0.5  3.6 -2.5

# === LEFT WING: extends from top toward -X ===
v -0.5  3.6  2.5
v -9.0  5.0  2.5
v -9.0  5.0 -2.5
v -0.5  3.6 -2.5

# === STINGER: small point extending from back (-Z) ===
v  0.5  0.5 -3.5
v -0.5  0.5 -3.5
v  0.0  0.0 -5.5
v  0.5 -0.5 -3.5
v -0.5 -0.5 -3.5

# =============================================
# Body UVs (existing layout for 7x7 cube)
# =============================================
# Top (7..14, 0..7) -> U: 7/64 to 14/64, V: 25/32 to 32/32
vt 0.109375 0.78125
vt 0.21875 0.78125
vt 0.21875 1.0
vt 0.109375 1.0

# Bottom (14..21, 0..7)
vt 0.21875 0.78125
vt 0.328125 0.78125
vt 0.328125 1.0
vt 0.21875 1.0

# Right (0..7, 7..14)
vt 0.0 0.5625
vt 0.109375 0.5625
vt 0.109375 0.78125
vt 0.0 0.78125

# Front (7..14, 7..14)
vt 0.109375 0.5625
vt 0.21875 0.5625
vt 0.21875 0.78125
vt 0.109375 0.78125

# Left (14..21, 7..14)
vt 0.21875 0.5625
vt 0.328125 0.5625
vt 0.328125 0.78125
vt 0.21875 0.78125

# Back (21..28, 7..14)
vt 0.328125 0.5625
vt 0.4375 0.5625
vt 0.4375 0.78125
vt 0.328125 0.78125

# =============================================
# Wing UVs: rows 0-4, cols 40-55 in 64x32 texture
# U: [40/64, 55/64] = [0.625, 0.859375]
# V: [1-4/32, 1-0/32] = [0.875, 1.0]
# =============================================
vt 0.625 0.875
vt 0.859375 0.875
vt 0.859375 1.0
vt 0.625 1.0

# =============================================
# Stinger UVs: reuse a small brown body region
# Use a 2x2 area from col 32-33, row 5-6 (brown stinger color)
# U: [32/64, 34/64] = [0.5, 0.53125]
# V: [1-6/32, 1-5/32] = [0.8125, 0.84375]
# =============================================
vt 0.5 0.8125
vt 0.53125 0.8125
vt 0.515625 0.84375

# =============================================
# Normals
# =============================================
vn  0  0  1
vn  0  0 -1
vn  0  1  0
vn  0 -1  0
vn  1  0  0
vn -1  0  0

usemtl bee-mat
s off

# =============================================
# BODY FACES (same as original)
# =============================================
# Front (Z+)
f 1/13/1 2/14/1 3/15/1 4/16/1
# Back (Z-)
f 6/21/2 5/22/2 8/23/2 7/24/2
# Top (Y+)
f 4/1/3 3/2/3 7/3/3 8/4/3
# Bottom (Y-)
f 5/5/4 6/6/4 2/7/4 1/8/4
# Right (X+)
f 2/9/5 6/10/5 7/11/5 3/12/5
# Left (X-)
f 5/17/6 1/18/6 4/19/6 8/20/6

# =============================================
# RIGHT WING FACES (vertices 9-12, wing UVs 25-28)
# =============================================
# Top face (normal up)
f 9/25/3 10/26/3 11/27/3 12/28/3
# Bottom face (normal down, reversed winding)
f 12/28/4 11/27/4 10/26/4 9/25/4

# =============================================
# LEFT WING FACES (vertices 13-16, wing UVs 25-28 mirrored)
# =============================================
# Top face (normal up)
f 16/25/3 15/26/3 14/27/3 13/28/3
# Bottom face (normal down, reversed winding)
f 13/28/4 14/27/4 15/26/4 16/25/4

# =============================================
# STINGER (vertices 17-21, stinger UVs 29-31)
# =============================================
# Top triangle
f 17/29/3 18/30/3 19/31/3
# Bottom triangle
f 21/29/4 20/30/4 19/31/4
# Right side triangle
f 17/29/5 19/31/5 20/30/5
# Left side triangle
f 18/29/6 19/31/6 21/30/6
